# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv


.env
data/

# Machine-specific config and Kerberos secrets
config/config.local.yaml
*.keytab
# Local make entry point of a machine ("include Makefile.ubi"): make reads it before Makefile
GNUmakefile
# Semantic layer and eval files: only the demo databases are shared, a private
# database's (generated on its own machine) stays there
semantic_layer/*
!semantic_layer/Chinook/
!semantic_layer/Northwind/
offline/eval/datasets/*
!offline/eval/datasets/chinook.yaml
!offline/eval/datasets/northwind.yaml
offline/eval/results/*
!offline/eval/results/chinook.json
!offline/eval/results/northwind.json
# Chainlit: keep the app config and the customized English and French translations
.chainlit/*
!.chainlit/config.toml
!.chainlit/translations/
.chainlit/translations/*
!.chainlit/translations/en-US.json
!.chainlit/translations/fr-FR.json
src/.chainlit/
.files/
.vscode/
.claude/
